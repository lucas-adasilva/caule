rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Mesmo padrao permissivo do firestore.rules: qualquer usuario autenticado pode
    // ler/escrever (avatares, foto da casa, fotos de ciclos pendentes, etc.) - a regra
    // anterior exigia um custom claim 'role' que nunca e configurado em lugar nenhum do
    // codigo, e checava o caminho errado pro avatar (users/{uid}/avatar em vez de
    // avatars/{uid}, que e o que o app realmente usa), entao na pratica bloqueava upload
    // pra todo mundo.
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
